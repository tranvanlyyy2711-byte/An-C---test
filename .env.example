# Chạy prototype
AN_CU_ORIGIN=http://localhost:5500

# Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5500/api/google-calendar/callback

# Chỉ cần khi deploy lên URL HTTPS để Google tự đẩy thay đổi về website.
GOOGLE_CALENDAR_WEBHOOK_URL=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=thay-bang-chuoi-ngau-nhien-dai

# Supabase — đăng ký / đăng nhập thật (bản trên Vercel)
# Khoá công khai (publishable/anon) còn được khai lại ở components/cau-hinh-supabase.js vì trang tĩnh
# không đọc được biến môi trường. KHÔNG bao giờ để service_role key ở đây hay trong components/.
SUPABASE_URL=
SUPABASE_ANON_KEY=
