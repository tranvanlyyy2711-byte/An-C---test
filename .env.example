# Chạy prototype
AN_CU_ORIGIN=http://localhost:5500

# Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5500/api/google-calendar/callback

# Chỉ cần khi deploy lên URL HTTPS để Google tự đẩy thay đổi về website.
GOOGLE_CALENDAR_WEBHOOK_URL=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=thay-bang-chuoi-ngau-nhien-dai

# Supabase — đăng ký / đăng nhập thật (bản trên Vercel)
# Khoá công khai (publishable/anon) còn được khai lại ở components/cau-hinh-supabase.js vì trang tĩnh
# không đọc được biến môi trường. KHÔNG bao giờ để service_role key ở đây hay trong components/.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# payOS — thanh toán gói dịch vụ bằng VietQR (lấy ở my.payos.vn > Kênh thanh toán)
# CHỈ phía máy chủ: máy chủ prototype đọc từ .env.local, bản Vercel đọc từ Project Settings >
# Environment Variables. Tuyệt đối không đưa ba khoá này vào components/ hay bất kỳ file nào
# trình duyệt tải về.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Chỉ đổi khi cần trỏ sang máy chủ payOS giả lúc kiểm thử
# PAYOS_API_URL=https://api-merchant.payos.vn

# Supabase phía máy chủ cho Serverless Function thanh toán (api/payment/*).
# SERVICE_ROLE đi xuyên RLS — chỉ khai trên Vercel, không bao giờ để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=
# Địa chỉ gốc của bản deploy, dùng cho returnUrl/cancelUrl của payOS
AN_CU_SITE_URL=https://an-cu.vercel.app

